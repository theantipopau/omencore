<Window x:Class="OmenCore.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OmenCore.ViewModels"
        xmlns:views="clr-namespace:OmenCore.Views"
        xmlns:controls="clr-namespace:OmenCore.Controls"
        xmlns:models="clr-namespace:OmenCore.Models"
        xmlns:utils="clr-namespace:OmenCore.Utils"
        mc:Ignorable="d"
        Title="OmenCore - Gaming Laptop Control Center" Height="900" Width="1500" MinHeight="500" MinWidth="800"
        Icon="pack://application:,,,/OmenCore;component/Assets/OmenCore.ico"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="OmenCore Gaming Laptop Control Center">
    
    <!-- Keyboard Shortcuts for refresh -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding CheckForUpdatesCommand}" />
    </Window.InputBindings>
    
    <!-- DataContext will be set via dependency injection in code-behind -->
    
    <!--
        No Border.Effect here on purpose: this Border wraps the entire window content
        (title bar, sidebar, every tab). AllowsTransparency="True" + WindowStyle="None"
        already force this whole window into software-composited rendering (a Win32
        layered window) - stacking a DropShadowEffect on top of that means every redraw
        of anything inside the window (resize, drag, any content change) additionally
        renders the full window subtree to an offscreen surface and runs a blur pixel
        shader over it, on the root of the entire visual tree. That's a real, continuous
        cost on the single most common interaction (resize/move), for a shadow subtle
        enough most users won't consciously notice its absence.
    -->
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
            Background="{StaticResource BackgroundDarkBrush}">
        <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceDarkBrush}" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="44">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                        <!-- App Title -->
                        <Image Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0">
                            <Image.Source>
                                <BitmapImage UriSource="pack://application:,,,/Assets/logo-small.png" DecodePixelWidth="40" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="OmenCore" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        
                        <!-- Version Badge -->
                        <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                           <TextBlock Text="{Binding AppVersionLabel}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                        </Border>
                        
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                        <Button Content="-" Click="MinimizeButton_Click" Style="{StaticResource WindowControlButton}" ToolTip="Minimize" FontSize="12" />
                        <Button x:Name="MaximizeButton" Content="[ ]" Click="MaximizeButton_Click" Style="{StaticResource WindowControlButton}" ToolTip="Maximize" FontSize="12" />
                        <Button Content="x" Click="CloseButton_Click" Style="{StaticResource WindowCloseButton}" ToolTip="Close" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- System-info + Utility Bar: everything that used to live at the bottom of the
                 sidebar (specs, Export/Import/Profiles/About/Check for Updates) moved here so
                 the sidebar itself can just be logo + live status + quick actions + nav tabs,
                 one continuous panel, per user request. WrapPanel on the left so long CPU/GPU
                 names reflow to a second line instead of clipping at narrow window widths. -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceDarkBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="24,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <!-- HP OMEN Model (shown for HP gaming systems) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,20,2"
                                    Visibility="{Binding SystemInfo.IsHpGaming, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                    ToolTip="{Binding SystemInfo.ModelName}">
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Width="20" Height="20" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/omen.png" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding SystemInfo.ModelName, FallbackValue=HP OMEN Laptop}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                        </StackPanel>

                        <!-- CPU -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,20,2"
                                    ToolTip="{Binding SystemInfo.CpuName}">
                            <Image Width="16" Height="16" VerticalAlignment="Center">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="pack://application:,,,/Assets/intel.png" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SystemInfo.CpuVendor}" Value="AMD">
                                                <Setter Property="Source" Value="pack://application:,,,/Assets/amd.png" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220">
                                <Run Text="{Binding SystemInfo.CpuName, Mode=OneWay}"/>
                                <Run Text=" ("/><Run Text="{Binding SystemInfo.CpuCores, Mode=OneWay}"/><Run Text="C/"/><Run Text="{Binding SystemInfo.CpuThreads, Mode=OneWay}"/><Run Text="T)"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- RAM -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,20,2">
                            <Border Background="{StaticResource AccentPurpleBrush}" CornerRadius="4" Width="16" Height="16" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRam}" Width="10" Height="10" Fill="White" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding SystemInfo.RamSizeFormatted}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- GPU(s) -->
                        <ItemsControl ItemsSource="{Binding SystemInfo.Gpus}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,20,2" ToolTip="{Binding Name}">
                                        <Image Width="16" Height="16" VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="pack://application:,,,/Assets/nvidia.png" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Vendor}" Value="AMD">
                                                            <Setter Property="Source" Value="pack://application:,,,/Assets/amd.png" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Vendor}" Value="Intel">
                                                            <Setter Property="Source" Value="pack://application:,,,/Assets/intel.png" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <!-- Quick Actions: icon-only, moved here from the sidebar so the sidebar's
                         vertical space goes entirely to the nav tabs (the actual navigation) -
                         a short window was squeezing the tab list under Quick Actions' fixed
                         height there. Icon + tooltip is enough here: these are muscle-memory
                         actions, not menu items someone reads to orient themselves. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Command="{Binding ApplyFanPresetCommand}" Style="{StaticResource SecondaryButton}" Width="34" Height="30" Padding="0" Margin="0,0,6,0" ToolTip="Apply your saved fan preset">
                            <Path Data="{StaticResource IconFan}" Width="14" Height="14" Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform"/>
                        </Button>
                        <Button Command="{Binding ApplyPerformanceModeCommand}" Style="{StaticResource SecondaryButton}" Width="34" Height="30" Padding="0" Margin="0,0,6,0" ToolTip="Switch performance profile">
                            <Path Data="{StaticResource IconPerformance}" Width="14" Height="14" Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform"/>
                        </Button>
                        <Button Command="{Binding ApplyLightingProfileCommand}" Style="{StaticResource SecondaryButton}" Width="34" Height="30" Padding="0" Margin="0,0,6,0" ToolTip="Apply RGB lighting">
                            <Path Data="{StaticResource IconLighting}" Width="14" Height="14" Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform"/>
                        </Button>
                        <Button Command="{Binding GamingModeCommand}" Style="{StaticResource SecondaryButton}" Width="34" Height="30" Padding="0" Margin="0,0,6,0" ToolTip="Enable gaming optimizations">
                            <Path Data="{StaticResource IconGamepad}" Width="14" Height="14" Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform"/>
                        </Button>
                        <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="4,4,10,4"/>
                        <Button Command="{Binding RestoreDefaultsCommand}" Style="{StaticResource SecondaryButton}" Width="34" Height="30" Padding="0" ToolTip="Restore Defaults: reset fan curves, lighting, and performance mode to their defaults">
                            <Path Data="{StaticResource IconRestore}" Width="13" Height="13" Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <!-- Utility buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ExportConfigurationCommand}" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,4" Margin="0,0,8,0" ToolTip="Export your settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconExport}" Width="12" Height="12" Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="Export" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportConfigurationCommand}" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,4" Margin="0,0,8,0" ToolTip="Import settings file">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconImport}" Width="12" Height="12" Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="Import" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenGameProfileManagerCommand}" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,4" Margin="0,0,8,0" ToolTip="Manage per-game settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconGamepad}" Width="12" Height="12" Fill="{StaticResource AccentPurpleBrush}" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="Profiles" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenAboutCommand}" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,4" Margin="0,0,8,0" ToolTip="About OmenCore">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconAbout}" Width="12" Height="12" Fill="{StaticResource AccentBlueBrush}" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="About" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CheckForUpdatesCommand}" Height="30" Padding="10,4" ToolTip="Manually check for a new version">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#1A2332" Offset="0"/>
                                                <GradientStop Color="#1E2940" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUpdate}" Width="12" Height="12" Fill="{StaticResource SuccessBrush}" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Check for Updates" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="256" MinWidth="200" MaxWidth="300" />
                    <ColumnDefinition Width="*" MinWidth="520" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" CornerRadius="0,0,0,12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0D1117" Offset="0"/>
                            <GradientStop Color="#0A0E14" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel LastChildFill="True" Margin="16,20,16,20">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                            <!-- Brand Header with Glow Effect -->
                            <Border Background="Transparent" Padding="8" Margin="-8,0,-8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border CornerRadius="8" Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FF005C" BlurRadius="12" Opacity="0.3" ShadowDepth="0"/>
                                        </Border.Effect>
                                        <Image Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Source>
                                                <BitmapImage UriSource="pack://application:,,,/Assets/logo-small.png" DecodePixelWidth="72" CacheOption="OnLoad"/>
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="OmenCore" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" />
                                        <TextBlock Text="C O N T R O L   C E N T E R" Foreground="{StaticResource AccentBrush}" FontSize="8" FontWeight="Bold" Opacity="0.9"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <!-- Live Status Card with Enhanced Design -->
                            <Border Margin="0,16,0,0" CornerRadius="10" Padding="14,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#161B28" Offset="0"/>
                                        <GradientStop Color="#12161F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="8" Opacity="0.2" ShadowDepth="2" Direction="270"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Performance Mode -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Path Data="{StaticResource IconPerformance}" Width="12" Height="12" Fill="{StaticResource AccentBrush}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="PERFORMANCE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Dashboard.CurrentPerformanceMode, FallbackValue=--}" 
                                                   FontSize="13" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Fan Mode -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Path Data="{StaticResource IconFan}" Width="12" Height="12" Fill="{StaticResource AccentBlueBrush}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="FAN MODE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Dashboard.CurrentFanMode, FallbackValue=--}" 
                                                   FontSize="13" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FanPerformanceLinkStatus}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    
                                    <!-- Live Temp Indicators -->
                                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0" 
                                            Background="{StaticResource SurfaceDarkBrush}" CornerRadius="6" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <TextBlock Text="CPU" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Dashboard.CpuTempChipDisplay, FallbackValue=--°C}"
                                                           FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                                                           FontFamily="{StaticResource MonospaceFontFamily}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Dashboard.IsCpuTempAvailable}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                                    <Setter Property="ToolTip" Value="CPU temperature sensor unavailable"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BorderBrush}" Margin="8,2"/>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <TextBlock Text="GPU" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Dashboard.GpuTempChipDisplay, FallbackValue=--°C}"
                                                           FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                                                           FontFamily="{StaticResource MonospaceFontFamily}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Dashboard.IsGpuTempAvailable}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                                    <Setter Property="ToolTip" Value="GPU temperature sensor unavailable"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Monitoring Source + EC Backend -->
                                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                            Background="{StaticResource SurfaceDarkBrush}" CornerRadius="6" Padding="10,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Monitoring health dot + source label. Grid, not a horizontal
                                                 StackPanel: a horizontal StackPanel gives its children unbounded
                                                 width during measure, so TextTrimming below would never actually
                                                 engage - the text would just render at full width and get hard-
                                                 clipped (no ellipsis) at this cell's boundary once "*" ran out of
                                                 room, instead of trimming gracefully. Same root cause as the tab
                                                 header fix - see Omen.TabHeaderText. -->
                                            <Grid Grid.Column="0" VerticalAlignment="Center"
                                                  ToolTip="{Binding Dashboard.MonitoringHealthStatusText}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0"
                                                         Fill="{Binding Dashboard.MonitoringHealthColor, Converter={StaticResource HexToBrushConverter}, FallbackValue=#95A5A6}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Dashboard.MonitoringSourceText, FallbackValue=No source}"
                                                           FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <!-- EC backend badge -->
                                            <Border Grid.Column="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center"
                                                    ToolTip="{Binding EcBackend, StringFormat='EC backend: {0}'}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1A2E1A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EcBackend}" Value="None">
                                                                <Setter Property="Background" Value="#2A1A1A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EcBackend}" Value="Error">
                                                                <Setter Property="Background" Value="#2A1A1A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="9" FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            <Setter Property="Text" Value="{Binding EcBackend}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EcBackend}" Value="None">
                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                    <Setter Property="Text" Value="No EC"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EcBackend}" Value="Error">
                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                    <Setter Property="Text" Value="EC Err"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Nav tabs: the DockPanel's LastChildFill child, so this fills all
                             remaining sidebar height flush to its bottom rounded corner - the
                             "logo, then tabs underneath" layout. The TabControl lives here, in
                             the sidebar, while its selected content renders in the Main Content
                             grid to the right via a plain ContentPresenter bound to this
                             control's SelectedContent by ElementName - see Omen.NavRailTabControl
                             for why that split is safe. -->
                        <TabControl Style="{StaticResource Omen.NavRailTabControl}" ItemContainerStyle="{StaticResource Omen.NavRailTabItem}" x:Name="TabControlMain" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                            <!-- Tab indices: General(0), Custom(1), Tuning(2), Diagnostics(3), Monitoring(4), Optimizer(5), Memory(6), Bloatware(7), RGB(8), Settings(9), Games(10) -->
                            <!-- General Tab: Performance + Fan Profiles (Paired) -->
                            <TabItem x:Name="GeneralTabItem">
                                <TabItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconPerformance}" Style="{StaticResource Omen.TabHeaderIcon}"/>
                                        <TextBlock Grid.Column="1" Text="General" Style="{StaticResource Omen.TabHeaderText}"/>
                                        </Grid>
                                </TabItem.Header>
                            </TabItem>

                            <!-- Custom Tab: visible only when Custom profile is active -->
                            <TabItem x:Name="OmenTabItem">
                                <TabItem.Style>
                                    <Style TargetType="TabItem" BasedOn="{StaticResource Omen.NavRailTabItem}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowAdvancedControls}" Value="True"/>
                                                    <Condition Binding="{Binding General.IsCustomSelected}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TabItem.Style>
                                <TabItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconCpu}" Style="{StaticResource Omen.TabHeaderIcon}"/>
                                        <TextBlock Grid.Column="1" Text="Custom" Style="{StaticResource Omen.TabHeaderText}"/>
                                        </Grid>
                                </TabItem.Header>
                            </TabItem>

                            <!-- Tuning Tab: CPU Undervolt, Power Limits, GPU OC -->
                            <TabItem x:Name="TuningTabItem" Visibility="{Binding ShowAdvancedControls, Converter={StaticResource BoolToVisibility}}">
                                <TabItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconTune}" Style="{StaticResource Omen.TabHeaderIcon}"/>
                                        <TextBlock Grid.Column="1" Text="Tuning" Style="{StaticResource Omen.TabHeaderText}"/>
                                        </Grid>
                                </TabItem.Header>
                            </TabItem>

                            <!-- Diagnostics Tab: Fan and Keyboard Testing (GitHub #48 - kg290) -->
                            <!-- Group: insight (Diagnostics, Monitoring) -->
                            <TabItem x:Name="DiagnosticsTabItem" Tag="GroupStart" Visibility="{Binding ShowAdvancedControls, Converter={StaticResource BoolToVisibility}}">
                                <TabItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconWarning}" Style="{StaticResource Omen.TabHeaderIcon}"/>
                                        <TextBlock Grid.Column="1" Text="Diagnostics" Style="{StaticResource Omen.TabHeaderText}"/>
                                        </Grid>
                                </TabItem.Header>
                            </TabItem>

                            <!-- Monitoring Tab with Hardware Monitoring Dashboard -->
                            <TabItem x:Name="MonitoringTabItem">
                                <TabItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconMonitoring}" Style="{StaticResource Omen.TabHeaderIcon}"/>
                                        <TextBlock Grid.Column="1" Text="Monitoring" Style="{StaticResource Omen.TabHeaderText}"/>
                                        </Grid>
                                </TabItem.Header>
                                <!-- Content will be created programmatically in code-behind -->
                            </TabItem>

                            <!-- System Optimizer Tab - Windows Gaming Tweaks -->
                            <!-- Group: system cleanup (Optimizer, Memory, Bloatware) -->
                            <TabItem x:Name="OptimizerTabItem" Tag="GroupStart" Visibility="{Binding ShowAdvancedControls, Converter={StaticResource BoolToVisibility}}">
                                <TabItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconScale}" Style="{StaticResource Omen.TabHeaderIcon}"/>
                                        <TextBlock Grid.Column="1" Text="Optimizer" Style="{StaticResource Omen.TabHeaderText}"/>
                                        </Grid>
                                </TabItem.Header>
                            </TabItem>

                            <!-- Memory Optimizer Tab - RAM Cleaning & Monitoring -->
                            <TabItem x:Name="MemoryTabItem" Visibility="{Binding ShowAdvancedControls, Converter={StaticResource BoolToVisibility}}">
                                <TabItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconRam}" Style="{StaticResource Omen.TabHeaderIcon}"/>
                                        <TextBlock Grid.Column="1" Text="Memory" Style="{StaticResource Omen.TabHeaderText}"/>
                                        </Grid>
                                </TabItem.Header>
                            </TabItem>

                            <!-- Bloatware Manager Tab -->
                            <TabItem x:Name="BloatwareTabItem" Visibility="{Binding ShowAdvancedControls, Converter={StaticResource BoolToVisibility}}">
                                <TabItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconTrash}" Style="{StaticResource Omen.TabHeaderIcon}"/>
                                        <TextBlock Grid.Column="1" Text="Bloatware" Style="{StaticResource Omen.TabHeaderText}"/>
                                        </Grid>
                                </TabItem.Header>
                            </TabItem>

                            <!-- Peripherals Tab with Lighting View -->
                            <!-- Group: personalization (RGB) -->
                            <TabItem x:Name="RgbTabItem" Tag="GroupStart" Visibility="{Binding ShowAdvancedControls, Converter={StaticResource BoolToVisibility}}">
                                <TabItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconLighting}" Style="{StaticResource Omen.TabHeaderIcon}"/>
                                        <TextBlock Grid.Column="1" Text="RGB" Style="{StaticResource Omen.TabHeaderText}"/>
                                        </Grid>
                                </TabItem.Header>
                            </TabItem>

                            <!-- Settings Tab -->
                            <!-- Group: app (Settings, Games) -->
                            <TabItem x:Name="SettingsTabItem" Tag="GroupStart">
                                <TabItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconSettings}" Style="{StaticResource Omen.TabHeaderIcon}"/>
                                        <TextBlock Grid.Column="1" Text="Settings" Style="{StaticResource Omen.TabHeaderText}"/>
                                        </Grid>
                                </TabItem.Header>
                            </TabItem>

                            <!-- Game Library Tab -->
                            <TabItem x:Name="GamesTabItem">
                                <TabItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconGamepad}" Style="{StaticResource Omen.TabHeaderIcon}"/>
                                        <TextBlock Grid.Column="1" Text="Games" Style="{StaticResource Omen.TabHeaderText}"/>
                                        </Grid>
                                </TabItem.Header>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>

                <!-- Main Content -->
                <Grid Grid.Column="1" Background="{StaticResource BackgroundDarkBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Update Banner + Non-HP Warning -->
                    <StackPanel Grid.Row="0">
                        <Border Style="{StaticResource PremiumInfoBannerCard}"
                                Padding="16"
                                Margin="24,12,24,8"
                                Visibility="{Binding UpdateBannerVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- Update Banner Header -->
                                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconUpdate}" Width="20" Height="20" Fill="{StaticResource AccentBlueBrush}" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="Update Ready" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding UpdateBannerMessage}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Buttons -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Install Update"
                                            Command="{Binding InstallUpdateCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Width="140"
                                            Height="34"
                                            Margin="0,0,8,0" />
                                    <Button Content="Release Notes"
                                            Command="{Binding OpenReleaseNotesCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Width="130"
                                            Height="34" />
                                </StackPanel>
                                
                                <!-- Download Progress -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                            Margin="34,12,0,0"
                                            Visibility="{Binding UpdateDownloadInProgress, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <ProgressBar Value="{Binding UpdateDownloadProgress, Mode=OneWay}" 
                                                 Minimum="0" Maximum="100" 
                                                 Height="8" 
                                                 BorderThickness="0"
                                                 Foreground="{StaticResource AccentBlueBrush}"
                                                 Background="{StaticResource SurfaceDarkBrush}"
                                                 Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding UpdateDownloadStatus, Mode=OneWay}" 
                                               FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontFamily="{StaticResource MonospaceFontFamily}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource PremiumPanelCard}"
                            Background="#2A4C3517"
                                BorderBrush="{StaticResource WarningBrush}"
                                BorderThickness="2"
                                Padding="14,10"
                                Margin="24,12,24,12"
                                Visibility="{Binding ShowUnsupportedSystemBanner, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconWarning}" Width="22" Height="22" Fill="{StaticResource WarningBrush}" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Warning: Unsupported System Detected"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="14" />
                                    <TextBlock Text="OmenCore is built for HP OMEN and Victus gaming laptops. This system isn't detected as either, so most hardware-control features will be unavailable - this is a hardware/firmware limitation, not something a model-database update can fix."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PremiumPanelCard}"
                            Background="#2A4C3517"
                                BorderBrush="{StaticResource WarningBrush}"
                                BorderThickness="2"
                                Padding="14,10"
                                Margin="24,12,24,12"
                                Visibility="{Binding ShowUnverifiedModelBanner, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconWarning}" Width="22" Height="22" Fill="{StaticResource WarningBrush}" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Notice: Model Not Yet Field-Confirmed"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="14" />
                                    <TextBlock Text="This is a real HP OMEN/Victus system, but this exact model's capabilities are inferred rather than confirmed by another user - see the Diagnostics tab for exactly which features that affects. Most functionality should still work; please report anything that looks wrong."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Selected tab's content. TabControlMain itself now lives in the sidebar
                         (see the Sidebar Border above) - only its rail is there. The content
                         is presented here via a plain binding to TabControlMain's
                         SelectedContent property by ElementName, which works because
                         SelectedContent is a normal bindable TabControl property, not
                         something that has to live inside the control's own template. -->
                    <Border Grid.Row="1" Margin="24,0,24,12">
                        <ContentPresenter Content="{Binding SelectedContent, ElementName=TabControlMain}"/>
                    </Border>

            <!-- Footer: Recent Activity and System Log (GitHub #48 - its-urbi: Collapsible logs) -->
            <Grid Grid.Row="2" Margin="24,0,24,12" MaxHeight="180">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- Collapse/Expand Toggle -->
                <Button Grid.Row="0" HorizontalAlignment="Right" Content="{Binding LogsToggleText}"
                        Command="{Binding ToggleLogsCommand}" Style="{StaticResource LinkButton}" FontSize="11" Margin="0,0,0,4" />
                
                <Grid Grid.Row="1" Visibility="{Binding LogsCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0" Padding="12,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="RECENT ACTIVITY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,8" />
                            <ListBox ItemsSource="{Binding RecentEvents}" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontFamily="{StaticResource MonospaceFontFamily}" FontSize="11" 
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.CacheLength="5" VirtualizingPanel.CacheLengthUnit="Item" />
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="12,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="SYSTEM LOG" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,8" />
                            <ScrollViewer x:Name="SystemLogScrollViewer" Style="{StaticResource SmoothScrollViewer}">
                                <TextBlock Text="{Binding LogBuffer}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource MonospaceFontFamily}" FontSize="10" LineHeight="14" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
